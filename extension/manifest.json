{
  "manifest_version": 3,
  "name": "Wayfold Clipper",
  "version": "0.1.0",
  "description": "Save flights, hotels, trains and places from any page into your Wayfold trip.",
  "action": { "default_popup": "src/popup.html", "default_title": "Save to Wayfold" },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://www.google.com/maps/*",
    "https://www.google.com/travel/*",
    "http://localhost:5173/*"
  ]
}
