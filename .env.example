# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps Platform APIs.
GOOGLE_MAPS_PLATFORM_KEY=

# ── Standalone proxy deploy (see output/deploy-proxy.md) ──────────────────────
# GEMINI_FLASH_MODEL: optional Gemini model override (default: gemini-flash-latest).
# Recommend pinning a stable model e.g. gemini-2.5-flash — the `-latest` alias is slower and
# more 503-prone (high demand) than a pinned version.
GEMINI_FLASH_MODEL=

# GEMINI_THINKING_BUDGET: thinking-token budget for /api/copilot (default 0 = off). Copilot edits
# are structured, so thinking added ~40s for no quality gain; raise only if reply quality regresses.
GEMINI_THINKING_BUDGET=

# GEMINI_GROUNDING: set to 1/true to enable Google Search grounding on /api/copilot.
# Needs a PAID Gemini tier — free-tier keys 429 (RESOURCE_EXHAUSTED) on grounded calls,
# which silently drops every request to the deterministic fallback. Leave unset on free tier.
GEMINI_GROUNDING=

# CORS_ALLOWED_ORIGINS: comma-separated origins allowed to call /api cross-origin
# (e.g. the CDN origin serving the SPA, or a chrome-extension://<id>). Same-origin
# needs none. Required when the SPA is hosted on a different origin than the proxy.
CORS_ALLOWED_ORIGINS=

# API_AUTH_TOKEN: optional shared-token gate on /api/copilot + /api/ingest. If set,
# callers must send it as `Authorization: Bearer <token>` or `X-Api-Token`. Leave
# unset for the open demo. (Per-user auth is a later, paid-tier task.)
API_AUTH_TOKEN=

# ── Front-end (Vite, build-time) ──────────────────────────────────────────────
# VITE_API_BASE: absolute URL of the proxy when the SPA is served from a different
# origin (CDN). Leave empty for same-origin / combined deploy / local dev.
VITE_API_BASE=
# VITE_FREE_SESSION_COPILOT_CALLS: per-session free Copilot action cap (default 5).
VITE_FREE_SESSION_COPILOT_CALLS=
