rules_version = '2';
// Wayfold co-planning rules (docs/collab-model.md). Shared workspace = workspaces/{wsId} with a
// memberUids[] list; shared subtrees are member-gated, personal pockets are self-gated. Default deny.
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in (incl. anonymous) caller that is listed on the workspace.
    function isMember(wsId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/workspaces/$(wsId))
        && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(wsId)).data.memberUids;
    }
    function signedIn() { return request.auth != null; }

    // Per-user membership index + identity. Self only.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Invite codes resolve a join link → wsId. Public read (so a fresh user can resolve the link
    // before joining); writable only by a member of the target workspace.
    match /invites/{code} {
      allow read: if true;
      allow create, update, delete: if signedIn() && isMember(request.resource.data.wsId);
    }

    match /workspaces/{wsId} {
      // Create: the creator must put themselves on the member list. Read/update/delete: members only.
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberUids;
      allow read, update, delete: if isMember(wsId);

      // Shared subtrees — any member can read/write the one plan.
      match /days/{dayId}            { allow read, write: if isMember(wsId); }
      match /itinerary/{itemId}      { allow read, write: if isMember(wsId); }
      match /bookings/{bookingId}    { allow read, write: if isMember(wsId); }
      match /copilot/{msgId}         { allow read, write: if isMember(wsId); }

      // Personal pocket — each member's own research stash, scoped to their uid.
      match /pockets/{uid}/items/{itemId} {
        allow read, write: if signedIn() && request.auth.uid == uid && isMember(wsId);
      }
    }
  }
}
